{
  "name": "@rokmohar/alexa-assistant",
  "version": "2.1.4",
  "description": "An unofficial Google skill for Alexa",
  "license": "GPL-3.0",
  "author": "Rok Mohar",
  "main": "src/index.ts",
  "scripts": {
    "prepare": "husky",
    "build": "rimraf dist && npx webpack",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "start": "serverless offline",
    "test": "serverless invoke local --function alexa",
    "logs": "serverless logs -f alexa"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-dynamodb-persistence-adapter": "^2.14.0",
    "ask-sdk-model": "^1.86.0",
    "axios": "^1.21.0",
    "google-proto-files": "^6.1.0",
    "serverless": "^4.45.0",
    "serverless-alexa-skills": "^0.1.0",
    "serverless-offline": "^14.8.4",
    "serverless-webpack": "^5.16.2",
    "xml-escape": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/xml-escape": "^1.1.3",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "homepage": "https://github.com/rokmohar/alexa-assistant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokmohar/alexa-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/rokmohar/alexa-assistant/issues"
  },
  "keywords": [
    "alexa",
    "skill",
    "google",
    "assistant"
  ],
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
